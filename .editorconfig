root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = tab

[*.php]
indent_style = space
indent_size = 4

[*.{js,ts,mjs,cjs,vue,json,yml,yaml,css,scss}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{map,min.js,svg}]
charset = utf-8
insert_final_newline = false
