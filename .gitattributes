# Normalize line handling for text files; keep LFs in the repository.
* text=auto eol=lf

# Explicitly treat generated/binary-ish files as non-text for diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary

# The committed webpack bundles under js/ are build output; treat them as
# text (so review diffs work) but never let merge try to auto-resolve a bug
# into a generated bundle - regenerate instead.
js/** linguist-generated=true

# Exclude development-only files from packaged deployments (git archive /
# app store tarballs). CI uses a full checkout and is unaffected.
/.github export-ignore
/tests export-ignore
/docs export-ignore
/screenshots export-ignore
/coverage export-ignore
/node_modules export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
AGENTS.md export-ignore
CONTRIBUTING.md export-ignore
CODE_OF_CONDUCT.md export-ignore
eslint.config.js export-ignore
webpack.js export-ignore
babel.config.js export-ignore
phpunit.xml.dist export-ignore
